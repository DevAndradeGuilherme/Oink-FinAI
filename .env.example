APP_NAME=Oink FinAI
APP_ENV=development
APP_DEBUG=false
APP_RELOAD=false
PIPELINE_TIMING_ENABLED=false
APP_RELEASE=optional-opaque-release
DATABASE_URL=postgresql+asyncpg://development_role:replace-me-development-password@postgres:5432/application_database
MIGRATION_DATABASE_URL=postgresql+asyncpg://development_role:replace-me-development-password@postgres:5432/application_database
REDIS_URL=redis://redis:6379/0
DEFAULT_TIMEZONE=America/Sao_Paulo
OPENAI_API_KEY=your-openai-api-key
OPENAI_EXPENSE_MODEL=gpt-4.1-mini
OPENAI_EXPENSE_TIMEOUT_SECONDS=30
OPENAI_EXPENSE_MAX_OUTPUT_TOKENS=600
OPENAI_QUERY_MODEL=gpt-4.1-mini
OPENAI_QUERY_TIMEOUT_SECONDS=30
OPENAI_QUERY_MAX_OUTPUT_TOKENS=600
OPENAI_IMAGE_MODEL=gpt-4.1-mini
OPENAI_IMAGE_TIMEOUT_SECONDS=30
OPENAI_IMAGE_MAX_OUTPUT_TOKENS=500
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=90
OPENAI_AUDIO_TRANSCRIPTION_LANGUAGE=pt
EXPENSE_PROCESSING_MAX_ATTEMPTS=3
EXPENSE_RETRY_BASE_SECONDS=0.5
EXPENSE_RETRY_MAX_SECONDS=5
EVOLUTION_BASE_URL=https://evolution.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-instance-name
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_ACCESS_MODE=allowlist
WHATSAPP_ALLOWED_NUMBERS=your-number-in-e164
WHATSAPP_SELF_TEST_ENABLED=false
WHATSAPP_SELF_TEST_NUMBER=your-number-in-e164
WHATSAPP_SELF_TEST_PREFIX=!oink
INBOUND_MESSAGE_MAX_LENGTH=2000
EVOLUTION_WEBHOOK_MAX_BODY_BYTES=262144
EVOLUTION_WEBHOOK_HTTP_TIMEOUT_SECONDS=10
EVOLUTION_WEBHOOK_MAX_CONCURRENCY=8
READINESS_DATABASE_TIMEOUT_SECONDS=2
USAGE_WINDOW_TIMEZONE=UTC
INBOUND_USER_PER_MINUTE_LIMIT=10
INBOUND_USER_PER_DAY_LIMIT=150
INBOUND_GLOBAL_PER_DAY_LIMIT=600
OPENAI_USER_PER_DAY_LIMIT=60
OPENAI_GLOBAL_PER_DAY_LIMIT=240
OPENAI_GLOBAL_CONCURRENCY_LIMIT=2
OPENAI_TEXT_USER_PER_DAY_LIMIT=40
OPENAI_TEXT_GLOBAL_PER_DAY_LIMIT=160
OPENAI_QUERY_USER_PER_DAY_LIMIT=20
OPENAI_QUERY_GLOBAL_PER_DAY_LIMIT=80
OPENAI_IMAGE_USER_PER_DAY_LIMIT=12
OPENAI_IMAGE_GLOBAL_PER_DAY_LIMIT=48
OPENAI_AUDIO_USER_PER_DAY_LIMIT=10
OPENAI_AUDIO_GLOBAL_PER_DAY_LIMIT=40
OPENAI_RESERVATION_STALE_SECONDS=330
OPENAI_CONCURRENCY_RETRY_SECONDS=30
WHATSAPP_QUERY_MESSAGE_MAX_CHARS=3500
WHATSAPP_QUERY_MAX_PAGES=10
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=10
WORKER_PROCESSING_LOCK_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=60
WORKER_HEARTBEAT_DATABASE_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_RETENTION_DAYS=7
WORKER_HEARTBEAT_ID_PATH=/tmp/oink-finai-worker-id
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_STATE_TIMEOUT_SECONDS=300
EVOLUTION_TIMEOUT_SECONDS=10
EVOLUTION_MEDIA_TIMEOUT_SECONDS=15
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_DURATION_SECONDS=300
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
IMAGE_MAX_PIXELS=16000000
POSTGRES_DB=application_database
POSTGRES_USER=development_role
POSTGRES_PASSWORD=replace-me-development-password
